  "core_formulas": {
    "product_quality": "base_quality + qa_investment + rnd_bonus - technical_debt",
    "feature_completion": "completed_features / planned_features * 100",
    "innovation_score": "rnd_investment + new_features + technology_adoption",
    "product_readiness": "(development + testing + manufacturing) / 3",
    "product_rating": "customer_experience + quality + reliability",
    "demand_score": "market_fit + brand_awareness + marketing_impact",
    "product_health": "quality + customer_satisfaction + demand",
    "product_development_cost": "feature_cost + rnd_cost + testing_cost",
    "time_to_market": "remaining_development / development_velocity",
    "product_roi": "revenue_generated - development_cost"
