  "engine_formulas": {
    "available_budget": "opening_cash - reserve_cash",
    "closing_cash": "opening_cash + revenue - total_expenses - investments",
    "monthly_burn": "fixed_costs + variable_costs",
    "quarterly_burn": "monthly_burn * 3",
    "cash_runway": "cash_available / monthly_burn",
    "debt_ratio": "outstanding_debt / total_assets",
    "budget_utilisation": "total_budget_used / total_budget_allocated",
    "growth_investment_ratio": "growth_budget / total_budget",
    "reserve_ratio": "reserve_cash / cash_available",
    "operating_margin": "(revenue - operating_expenses) / revenue"
  },
