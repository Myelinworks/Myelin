# Supabase Postgres connection (async driver: asyncpg).
# Use the connection pooler URL (Dashboard -> Settings -> Database -> Connection Pooling),
# not the direct "db.<ref>.supabase.co" host -- that host is IPv6-only and unreachable from
# networks without native IPv6. The pooler host (aws-<n>-<region>.pooler.supabase.com) is
# IPv4-compatible. Session pooler (port 5432) supports prepared statements normally;
# transaction pooler (port 6543) requires disabling asyncpg's statement cache (already
# handled in app/core/db.py via connect_args={"statement_cache_size": 0}).
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:password@aws-1-your-region.pooler.supabase.com:5432/postgres

# Redis (Upstash-compatible)
REDIS_URL=rediss://default:password@your-upstash-endpoint:6379

APP_NAME=Myelin Backend
ENVIRONMENT=development

# Browser origins allowed to call this API. Comma-separated or a JSON array -- both parse.
# Must include the deployed frontend origin, or every browser request to a deployed backend
# fails CORS. Scheme included, no trailing slash.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional companion to CORS_ORIGINS, for hosts whose origin is not a fixed string. Vercel
# gives every deployment its own `<project>-<hash>-<scope>.vercel.app` origin, so the static
# list above goes stale on the next frontend deploy. Anchor both ends -- an unanchored pattern
# also matches `evil-my-elin-frontend.attacker.com`.
# CORS_ORIGIN_REGEX=^https://my-elin-frontend(-[a-z0-9]+)?-zenith-core\.vercel\.app$

# The browser origin the frontend is served from. Anything that has to point back at the
# frontend is derived from this -- currently the password-reset landing page.
FRONTEND_URL=http://localhost:3000

# Where Supabase sends the user after they click the password-reset email link. Optional --
# left blank it is derived as `{FRONTEND_URL}/reset-password`. Note the _URL suffix: the key
# is matched exactly, and a misspelled key is silently ignored (extra="ignore").
#
# IMPORTANT: this exact URL must also appear in the Supabase dashboard under Authentication ->
# URL Configuration -> Redirect URLs. Supabase silently replaces any redirect_to it does not
# recognise with the project's Site URL, and answers /auth/v1/recover with the same 200 either
# way -- so a missing allow-list entry only ever shows up as a 404 in a user's inbox. The
# backend probes for exactly this at startup and logs the fix if it is wrong.
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# Supabase API credentials (not used for the DB connection -- for future Auth/REST API work)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
