# Supabase Postgres connection (async driver: asyncpg).
# Use the connection pooler URL (Dashboard -> Settings -> Database -> Connection Pooling),
# not the direct "db.<ref>.supabase.co" host -- that host is IPv6-only and unreachable from
# networks without native IPv6. The pooler host (aws-<n>-<region>.pooler.supabase.com) is
# IPv4-compatible. Session pooler (port 5432) supports prepared statements normally;
# transaction pooler (port 6543) requires disabling asyncpg's statement cache (already
# handled in app/core/db.py via connect_args={"statement_cache_size": 0}).
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:password@aws-1-your-region.pooler.supabase.com:5432/postgres

# Redis (Upstash-compatible)
REDIS_URL=rediss://default:password@your-upstash-endpoint:6379

APP_NAME=Myelin Backend
ENVIRONMENT=development

# Browser origins allowed to call this API. Comma-separated or a JSON array -- both parse.
# Must include the deployed frontend origin, or every browser request to a deployed backend
# fails CORS. Scheme included, no trailing slash.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where Supabase sends the user after they click the password-reset email link. Note the
# _URL suffix: the key is matched exactly, and a misspelled key is silently ignored
# (extra="ignore"), leaving reset emails pointing nowhere.
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# Supabase API credentials (not used for the DB connection -- for future Auth/REST API work)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
